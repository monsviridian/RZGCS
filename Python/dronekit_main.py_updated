#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import sys
import os
import asyncio
import logging
from pathlib import Path

from PySide6.QtCore import QUrl, QObject, Signal, Slot, Property, QTimer
from PySide6.QtGui import QGuiApplication
from PySide6.QtQml import QQmlApplicationEngine

# Importiere die Backend- und Frontend-Kompatibilitätshelper
from qml_compatibility_aliases import register_frontend_qml_aliases
from backend_compatibility_aliases import setup_backend_compatibility_layer, apply_backend_compatibility_to_viewmodels

# Collections.MutableMapping Fix für Python 3.13
if sys.version_info >= (3, 10):
    import collections.abc
    if not hasattr(collections.abc, "MutableMapping"):
        import collections
        collections.MutableMapping = collections.abc.MutableMapping

# Eigene Importe
from backend.rzgcs_dronekit.connector import DroneKitConnector
from backend.messaging.message_manager import MessageManager
from viewmodels.firmware_viewmodel import FirmwareViewModel
from viewmodels.dronekit_viewmodel import SensorViewModel
from viewmodels.mission_planner_viewmodel import MissionPlannerViewModel

# Logger konfigurieren
logger = logging.getLogger(__name__)
logging.basicConfig(level=logging.INFO)

def main():
    app = QGuiApplication(sys.argv)
    engine = QQmlApplicationEngine()
    
    # Erstelle MessageManager
    message_manager = MessageManager()
    
    # DroneKit-Connector erstellen
    serial_connector = DroneKitConnector()
    serial_connector.setMessageManager(message_manager)
    
    # Erstelle Backend-Kompatibilitätsschicht
    compat_layer = setup_backend_compatibility_layer()
    compat_layer.register_backend("dronekit", serial_connector)
    compat_layer.set_active_backend("dronekit")
    
    # ViewModels erstellen
    sensor_viewmodel = SensorViewModel()
    mission_planner_viewmodel = MissionPlannerViewModel()
    firmware_vm = FirmwareViewModel()
    
    # Verbinde die Backend-Komponenten mit den ViewModels
    apply_backend_compatibility_to_viewmodels(
        compat_layer, 
        sensor_viewmodel=sensor_viewmodel, 
        mission_viewmodel=mission_planner_viewmodel, 
        parameter_viewmodel=None
    )
    
    # Status- und Log-Verbindungen für die UI
    serial_connector.connectionStatusChanged.connect(lambda status: message_manager.updateConnectionStatus(
        status == serial_connector.CONNECTION_STATUS_CONNECTED,
        "Verbunden" if status == serial_connector.CONNECTION_STATUS_CONNECTED else "Getrennt"
    ))
    
    # Erstelle ein Dictionary mit allen Komponenten für die QML-Engine
    components = {
        'serial_connector': serial_connector,
        'sensor_viewmodel': sensor_viewmodel,
        'mission_planner_viewmodel': mission_planner_viewmodel,
        'message_manager': message_manager,
        'logger': logger,
        'firmware_vm': firmware_vm
    }
    
    # Registriere die Hauptkomponenten und alle Aliase in der QML-Engine
    register_frontend_qml_aliases(engine, components)
    
    # Stelle sicher, dass der logger auch direkt verfügbar ist
    engine.rootContext().setContextProperty("logger", logger)
    
    # Stelle sicher, dass der messageManager auch für Screen01.ui.qml verfügbar ist
    print("messageManager wird für StatusBar bereitgestellt")
    
    # Pfad für QML-Dateien konfigurieren
    qml_path = Path(__file__).parent.parent
    engine.addImportPath(str(qml_path))
    
    # Lade die Hauptansicht
    ui_file = "ui/main.qml"
    engine.load(QUrl.fromLocalFile(os.path.join(os.path.abspath(os.path.dirname(__file__)), ui_file)))
    
    if not engine.rootObjects():
        logger.error("Fehler beim Laden der QML-Datei.")
        sys.exit(-1)
    
    # Event-Loop starten
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
