    @Slot(int, int, float, float, float, float, float, float, float)
    def send_command_long(self, command: int, confirmation: int = 0,
                         param1: float = 0, param2: float = 0, param3: float = 0,
                         param4: float = 0, param5: float = 0, param6: float = 0,
                         param7: float = 0) -> bool:
