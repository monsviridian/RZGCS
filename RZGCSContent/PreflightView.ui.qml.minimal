Check out https://doc.qt.io/qtcreator/creator-quick-ui-forms.html for details on .ui.qml files.
*/
import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

// Einfache Test-Version der PreflightView
Item {
    id: preflightview
    width: parent.width
    height: parent.height

    // Schwarzer Hintergrund
    Rectangle {
        id: background
        anchors.fill: parent
        color: "black"
        z: -1  // Hinter allen Elementen
    }

    // Einfache Test-Inhalte mit farbigen Rechtecken
    ColumnLayout {
        anchors.fill: parent
        spacing: 20

        // TEST: Rote Kopfzeile
        Rectangle {
            id: headerRect
            Layout.fillWidth: true
            height: 40
            color: "darkred"

            Text {
                anchors.centerIn: parent
                text: "TEST PREFLIGHT VIEW"
                color: "white"
                font.pixelSize: 18
                font.bold: true
            }
        }

        // TEST: Inhalt
        Rectangle {
            id: contentRect
            Layout.fillWidth: true
            Layout.fillHeight: true
            color: "darkblue"

            Text {
                anchors.centerIn: parent
                text: "Dies ist ein Test-Inhalt\nDie PreflightView wurde vereinfacht"
                color: "white"
                font.pixelSize: 20
                horizontalAlignment: Text.AlignHCenter
            }
        }
    }
}
